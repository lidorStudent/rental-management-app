# Dependencies
node_modules
.pnp
.pnp.js

# Next.js build output
.next
out
next-env.d.ts

# Environment variables. Real values never belong in the repository.
# Every .env is ignored by name rather than by prefix, so a file named for an environment this
# project does not use today cannot be committed by accident. .env.example is the deliberate
# exception: it is committed, and it holds no values.
.env
.env.local
.env.test
.env.production
.env.development
.env.staging
.env*.local

# Test output
coverage
playwright-report
test-results
blob-report
.playwright

# Deployment and tooling
.vercel
supabase/.temp
*.tsbuildinfo

# macOS
.DS_Store

# Generated from scripts/buildPresentation.mjs; the PDF it produces is the deliverable.
docs/presentation.html
# The same script drops slide screenshots in the project root on every run.
slide-*.png
