{
  "name": "rental-management-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:seed": "node --env-file=.env.test --experimental-strip-types supabase/seed.ts",
