# Copy this file to .env.local and fill in the values for your own Supabase project.
# Real values never belong in this file, because this file is committed.

# The Supabase project the application talks to.
# Supabase dashboard > your project > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# The public anonymous key. It is sent to the browser on purpose and grants nothing by itself,
# because every table is protected by Row Level Security and queries run as the signed-in user.
# Supabase dashboard > your project > Project Settings > API Keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. It bypasses Row Level Security, so it is server-only and must never carry
# the NEXT_PUBLIC_ prefix. One server action uses it, to create a tenant's account from a lease.
# Supabase dashboard > your project > Project Settings > API Keys > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The password the seed gives every demo account.
# Defaults to Demo-Rental-2026! when it is not set.
SEED_USER_PASSWORD=

# Optional. The address Playwright runs the end-to-end tests against.
# Defaults to http://localhost:3000, which is what the local dev server serves.
PLAYWRIGHT_BASE_URL=
